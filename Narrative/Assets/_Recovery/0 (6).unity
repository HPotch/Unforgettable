    OnEnd:
      m_PersistentCalls:
        m_Calls: []
    dontPlayAudio: 0
  - text: Ukko, wake up! I made you some coffee.
    color: {r: 1, g: 0.99607843, b: 0.9019608, a: 0.972549}
    fontSize: 23
    autoSkipTime: 0
    customNext: -1
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls: []
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
    dontPlayAudio: 0
  - text: '* You recognize your mothers voice *'
    color: {r: 1, g: 0.99607843, b: 0.9019608, a: 0.972549}
    fontSize: 40
    autoSkipTime: 0
    customNext: -1
    skipState: 0
