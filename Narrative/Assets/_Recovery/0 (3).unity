  m_Script: {fileID: 11500000, guid: 4ff8274bd4d41effe9968ce185ffa35e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueCaller
  audioClips: []
  dialogues:
  - text: 'Hi honey! How are you? '
    color: {r: 0, g: 0, b: 0, a: 1}
    fontSize: 40
    autoSkipTime: 0
    customNext: -1
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1571391564}
          m_TargetAssemblyTypeName: Portrait, Assembly-CSharp
          m_MethodName: ShowPortrait
          m_Mode: 3
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 1
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
    dontPlayAudio: 0
  - text: Yuck, this weather is awful!
    color: {r: 0, g: 0, b: 0, a: 1}
    fontSize: 40
    autoSkipTime: 0
    customNext: -1
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1571391564}
          m_TargetAssemblyTypeName: Portrait, Assembly-CSharp
          m_MethodName: ShowPortrait
          m_Mode: 3
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 2
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
    dontPlayAudio: 0
  - text: "You: Well than you better come in quickly, uhhm \u2026 darling!"
    color: {r: 0, g: 0, b: 0, a: 1}
    fontSize: 40
    autoSkipTime: 0
    customNext: -1
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1571391564}
          m_TargetAssemblyTypeName: Portrait, Assembly-CSharp
          m_MethodName: ShowPortrait
          m_Mode: 3
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
    dontPlayAudio: 0
  - text: "* Your daughter gives H\xEBlla a telling look *"
    color: {r: 0, g: 0, b: 0, a: 1}
    fontSize: 40
    autoSkipTime: 0
    customNext: -1
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1571391564}
          m_TargetAssemblyTypeName: Portrait, Assembly-CSharp
          m_MethodName: ShowPortrait
          m_Mode: 3
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 3
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
    dontPlayAudio: 0
  - text: '* You want to prove yourself, you know this *'
    color: {r: 0, g: 0, b: 0, a: 1}
    fontSize: 40
    autoSkipTime: 0
    customNext: -1
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls: []
    OnEnd:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 962398363}
          m_TargetAssemblyTypeName: DaughterScene, Assembly-CSharp
          m_MethodName: StartMiniGame
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
        - m_Target: {fileID: 1571391564}
          m_TargetAssemblyTypeName: Portrait, Assembly-CSharp
          m_MethodName: HidePortrait
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    dontPlayAudio: 0
  - text: ' '
    color: {r: 0, g: 0, b: 0, a: 1}
    fontSize: 40
    autoSkipTime: 0
    customNext: -1
    skipState: 2
    OnStart:
      m_PersistentCalls:
        m_Calls: []
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
    dontPlayAudio: 0
  - text: Eevi, Eevi! I know! Welcome!
    color: {r: 0, g: 0, b: 0, a: 1}
    fontSize: 40
    autoSkipTime: 0
    customNext: -1
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1571391564}
          m_TargetAssemblyTypeName: Portrait, Assembly-CSharp
          m_MethodName: ShowPortrait
          m_Mode: 3
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
    dontPlayAudio: 0
  - text: Morning, dad.
    color: {r: 0, g: 0, b: 0, a: 1}
    fontSize: 40
    autoSkipTime: 0
    customNext: -1
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1571391564}
          m_TargetAssemblyTypeName: Portrait, Assembly-CSharp
          m_MethodName: ShowPortrait
          m_Mode: 3
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 2
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
    dontPlayAudio: 0
  - text: '* She smiles *'
    color: {r: 0, g: 0, b: 0, a: 1}
    fontSize: 40
    autoSkipTime: 0
    customNext: -1
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1571391564}
          m_TargetAssemblyTypeName: Portrait, Assembly-CSharp
          m_MethodName: ShowPortrait
          m_Mode: 3
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 3
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
    dontPlayAudio: 0
  - text: "Now come on in Eevi, don\u2019t keep standing out in the rain."
    color: {r: 0, g: 0, b: 0, a: 1}
    fontSize: 40
    autoSkipTime: 0
    customNext: -1
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1571391564}
          m_TargetAssemblyTypeName: Portrait, Assembly-CSharp
          m_MethodName: ShowPortrait
          m_Mode: 3
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 1
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
    dontPlayAudio: 0
  - text: I shall venture inside, but we must first perform a most peculiar sorting of the parchments to discern the truly momentous from the utterly nonsensical, Father!
    color: {r: 0, g: 0, b: 0, a: 1}
    fontSize: 40
    autoSkipTime: 0
    customNext: -1
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1571391564}
          m_TargetAssemblyTypeName: Portrait, Assembly-CSharp
          m_MethodName: ShowPortrait
          m_Mode: 3
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 2
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
    dontPlayAudio: 0
  - text: Wha.. What are you saying?
    color: {r: 0, g: 0, b: 0, a: 1}
    fontSize: 40
    autoSkipTime: 0
    customNext: -1
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1571391564}
          m_TargetAssemblyTypeName: Portrait, Assembly-CSharp
          m_MethodName: ShowPortrait
          m_Mode: 3
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
    dontPlayAudio: 0
  - text: "You\u2019re right Eevi, can you do that with Ukko in a bit?"
    color: {r: 0, g: 0, b: 0, a: 1}
    fontSize: 40
    autoSkipTime: 0
    customNext: -1
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1571391564}
          m_TargetAssemblyTypeName: Portrait, Assembly-CSharp
          m_MethodName: ShowPortrait
          m_Mode: 3
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 1
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
    dontPlayAudio: 0
