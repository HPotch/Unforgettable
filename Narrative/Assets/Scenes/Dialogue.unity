  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  audioClips:
  - {fileID: 8300000, guid: 9536dbc8d1c8957e0ba7e687efa2e8f5, type: 3}
  - {fileID: 8300000, guid: dfd2e483d877c531ca63ee815d639163, type: 3}
  - {fileID: 8300000, guid: e24d17f7254216f848a3156e58711091, type: 3}
  - {fileID: 8300000, guid: f206028edca85ee6f8c1b01049e97a01, type: 3}
  - {fileID: 8300000, guid: 7b5ad6bf5fbec99bda37e20e202015cc, type: 3}
  - {fileID: 8300000, guid: 226478a54cdca1401b56a3796042f33d, type: 3}
  - {fileID: 8300000, guid: 51ed9e3b1415f4164b5ae1525caab2f0, type: 3}
  - {fileID: 8300000, guid: 344cfc2f2064119e19b64f938239bdb6, type: 3}
  - {fileID: 8300000, guid: ccfaab7ef64c8f482899cce106b0939a, type: 3}
  - {fileID: 8300000, guid: 4451fcb9ee16659df85fa23a1088922c, type: 3}
  - {fileID: 8300000, guid: 530cfa12ffc8c9b4e8a8aefb2747d013, type: 3}
  dialogues:
  - text: Ukko?
    color: {r: 0.72156864, g: 0.8, b: 0.6431373, a: 1}
    fontSize: 6
    autoSkipTime: 0
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls: []
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
  - text: Ukko, come, wake up!
    color: {r: 0.72156864, g: 0.8, b: 0.6431373, a: 1}
    fontSize: 6
    autoSkipTime: 0
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls: []
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
  - text: '* You recognize your mothers voice *'
    color: {r: 1, g: 0.9607843, b: 0.34509805, a: 1}
    fontSize: 4
    autoSkipTime: 0
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 962398360}
          m_TargetAssemblyTypeName: IntroScene, Assembly-CSharp
          m_MethodName: NextAudio
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
  - text: Ukko! Wake up!
    color: {r: 0.72156864, g: 0.8, b: 0.6431373, a: 1}
    fontSize: 6
    autoSkipTime: 0
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls: []
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
  - text: '*Yawn* Yeah, coming! '
    color: {r: 0.42745098, g: 0.21176471, b: 0.14901961, a: 1}
    fontSize: 6
    autoSkipTime: 2
    skipState: 1
    OnStart:
      m_PersistentCalls:
        m_Calls: []
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
  - text: 
    color: {r: 1, g: 1, b: 1, a: 1}
    fontSize: 6
    autoSkipTime: 0
    skipState: 2
    OnStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 962398360}
          m_TargetAssemblyTypeName: IntroScene, Assembly-CSharp
          m_MethodName: NextAudio
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
        - m_Target: {fileID: 962398360}
          m_TargetAssemblyTypeName: IntroScene, Assembly-CSharp
          m_MethodName: OpenEyes
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
        - m_Target: {fileID: 962398360}
          m_TargetAssemblyTypeName: IntroScene, Assembly-CSharp
          m_MethodName: MoveText
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
        - m_Target: {fileID: 1072446117}
          m_TargetAssemblyTypeName: BlurMiniGame, Assembly-CSharp
          m_MethodName: StartMiniGame
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
  - text: "* Weird\u2026 That doesn\u2019t seem like my mother *"
    color: {r: 1, g: 0.9607843, b: 0.34509805, a: 1}
    fontSize: 3
    autoSkipTime: 0
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 962398360}
          m_TargetAssemblyTypeName: IntroScene, Assembly-CSharp
          m_MethodName: NextAudio
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
  - text: '* She feels safe, though *'
    color: {r: 1, g: 0.9607843, b: 0.34509805, a: 1}
    fontSize: 3
    autoSkipTime: 0
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls: []
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
  - text: Mum?
    color: {r: 0.42745098, g: 0.21176471, b: 0.14901961, a: 1}
    fontSize: 6
    autoSkipTime: 0
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls: []
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
  - text: "Good morning, sweetheart, I am H\xEBlla, remember?"
    color: {r: 0.72156864, g: 0.8, b: 0.6431373, a: 1}
    fontSize: 6
    autoSkipTime: 0
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 962398360}
          m_TargetAssemblyTypeName: IntroScene, Assembly-CSharp
          m_MethodName: NextAudio
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
  - text: "* H\xEBlla is the name of your wife, you recall *"
    color: {r: 1, g: 0.9607843, b: 0.34509805, a: 1}
    fontSize: 3
    autoSkipTime: 0
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls: []
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
  - text: Yes, of course I knew that!
    color: {r: 0.42745098, g: 0.21176471, b: 0.14901961, a: 1}
    fontSize: 6
    autoSkipTime: 0
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls: []
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
  - text: "Right\u2026"
    color: {r: 0.72156864, g: 0.8, b: 0.6431373, a: 1}
    fontSize: 6
    autoSkipTime: 0
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls: []
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
  - text: Hey, it is alright, I am here for you.
    color: {r: 0.72156864, g: 0.8, b: 0.6431373, a: 1}
    fontSize: 6
    autoSkipTime: 0
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 962398360}
          m_TargetAssemblyTypeName: IntroScene, Assembly-CSharp
          m_MethodName: NextAudio
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
  - text: Hopefully today your memory is going to be better than yesterday.
    color: {r: 0.72156864, g: 0.8, b: 0.6431373, a: 1}
    fontSize: 6
    autoSkipTime: 0
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls: []
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
  - text: "I don\u2019t remember yesterday."
    color: {r: 0.42745098, g: 0.21176471, b: 0.14901961, a: 1}
    fontSize: 6
    autoSkipTime: 0
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls: []
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
  - text: Yesterday we went to the park, see?
    color: {r: 0.72156864, g: 0.8, b: 0.6431373, a: 1}
    fontSize: 6
    autoSkipTime: 0
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 962398360}
          m_TargetAssemblyTypeName: IntroScene, Assembly-CSharp
          m_MethodName: NextAudio
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    OnEnd:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 856125552}
          m_TargetAssemblyTypeName: Polaroid, Assembly-CSharp
          m_MethodName: ShowPolaroid
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - text: 
    color: {r: 1, g: 1, b: 1, a: 1}
    fontSize: 6
    autoSkipTime: 0
    skipState: 2
    OnStart:
      m_PersistentCalls:
        m_Calls: []
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
  - text: '* Of course, the park! The smell of flowers and the buzzing of bees fills your head *'
    color: {r: 1, g: 0.9607843, b: 0.34509805, a: 1}
    fontSize: 3
    autoSkipTime: 0
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls: []
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
  - text: "* You remember now, H\xEBlla always succeeds in getting some memory back *"
    color: {r: 1, g: 0.9607843, b: 0.34509805, a: 1}
    fontSize: 3
    autoSkipTime: 0
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 962398360}
          m_TargetAssemblyTypeName: IntroScene, Assembly-CSharp
          m_MethodName: NextAudio
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
  - text: '* She has been doing this for a long long time, you recall *'
    color: {r: 1, g: 0.9607843, b: 0.34509805, a: 1}
    fontSize: 3
    autoSkipTime: 0
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls: []
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
  - text: How do you feel?
    color: {r: 0.72156864, g: 0.8, b: 0.6431373, a: 1}
    fontSize: 6
    autoSkipTime: 0
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls: []
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
  - text: '* You try to put your feelings into words *'
    color: {r: 1, g: 0.9607843, b: 0.34509805, a: 1}
    fontSize: 3
    autoSkipTime: 0
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 962398360}
          m_TargetAssemblyTypeName: IntroScene, Assembly-CSharp
          m_MethodName: NextAudio
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
  - text: '* It is no use, though *'
    color: {r: 1, g: 0.9607843, b: 0.34509805, a: 1}
    fontSize: 3
    autoSkipTime: 0
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 962398360}
          m_TargetAssemblyTypeName: IntroScene, Assembly-CSharp
          m_MethodName: NextAudio
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
  - text: "Come on, let\u2019s make today worthwhile!"
    color: {r: 0.72156864, g: 0.8, b: 0.6431373, a: 1}
    fontSize: 6
    autoSkipTime: 0
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 962398360}
          m_TargetAssemblyTypeName: IntroScene, Assembly-CSharp
          m_MethodName: NextAudio
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
