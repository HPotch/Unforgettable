  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ff8274bd4d41effe9968ce185ffa35e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueCaller
  audioClips: []
  dialogues:
  - text: The city has been surrounded by animals!
    color: {r: 0, g: 0, b: 0, a: 1}
    fontSize: 40
    autoSkipTime: 0
    customNext: -1
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 661037911}
          m_TargetAssemblyTypeName: Portrait, Assembly-CSharp
          m_MethodName: ShowPortrait
          m_Mode: 3
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 4
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
  - text: Especially rabbits, they seem to have taken the lead in conquering this very part of the world!
    color: {r: 0, g: 0, b: 0, a: 1}
    fontSize: 40
    autoSkipTime: 0
    customNext: -1
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls: []
    OnEnd:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1375902402}
          m_TargetAssemblyTypeName: Fade, Assembly-CSharp
          m_MethodName: FadeIn
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
        - m_Target: {fileID: 1825686692}
          m_TargetAssemblyTypeName: Fade, Assembly-CSharp
          m_MethodName: FadeIn
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
        - m_Target: {fileID: 964306343}
          m_TargetAssemblyTypeName: Fade, Assembly-CSharp
          m_MethodName: FadeOut
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
        - m_Target: {fileID: 309511061}
          m_TargetAssemblyTypeName: Fade, Assembly-CSharp
          m_MethodName: FadeOut
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - text: "Oh, pray for my whiskers and tail, Ukko! This is dreadfully impolite, wouldn\u2019t you say?"
    color: {r: 0, g: 0, b: 0, a: 1}
    fontSize: 40
    autoSkipTime: 0
    customNext: -1
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 661037911}
          m_TargetAssemblyTypeName: Portrait, Assembly-CSharp
          m_MethodName: ShowPortrait
          m_Mode: 3
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 1
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
  - text: You speak the truth, dear mother. This is no more than a most troublesome predicament! This is truly, dreadfully, awfully catastrophic!
    color: {r: 0, g: 0, b: 0, a: 1}
    fontSize: 40
    autoSkipTime: 0
    customNext: -1
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 661037911}
          m_TargetAssemblyTypeName: Portrait, Assembly-CSharp
          m_MethodName: ShowPortrait
          m_Mode: 3
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 2
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
  - text: "We shall seize the city for ourselves! As you see, this is not a simple quarrel between good and wicked, it is a tumble into the deepest depths of bad versus bad! A clash of species against species! It is Eevi and H\xEBlla against, Ukko. No more, no less."
    color: {r: 0, g: 0, b: 0, a: 1}
    fontSize: 40
    autoSkipTime: 0
    customNext: -1
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 661037911}
          m_TargetAssemblyTypeName: Portrait, Assembly-CSharp
          m_MethodName: ShowPortrait
          m_Mode: 3
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 1
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
