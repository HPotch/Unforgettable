  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueCaller
  audioClips: []
  dialogues:
  - text: 'Hi honey! How are you? '
    color: {r: 0, g: 0, b: 0, a: 1}
    fontSize: 40
    autoSkipTime: 0
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1571391564}
          m_TargetAssemblyTypeName: Portrait, Assembly-CSharp
          m_MethodName: ShowPortrait
          m_Mode: 3
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 1
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
  - text: Yuck, this weather is awful!
    color: {r: 0, g: 0, b: 0, a: 1}
    fontSize: 40
    autoSkipTime: 0
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1571391564}
          m_TargetAssemblyTypeName: Portrait, Assembly-CSharp
          m_MethodName: ShowPortrait
          m_Mode: 3
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 2
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
  - text: "You: Well than you better come in quickly, uhhm \u2026 darling!"
    color: {r: 0, g: 0, b: 0, a: 1}
    fontSize: 40
    autoSkipTime: 0
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1571391564}
          m_TargetAssemblyTypeName: Portrait, Assembly-CSharp
          m_MethodName: ShowPortrait
          m_Mode: 3
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
  - text: "* Your daughter gives H\xEBlla a telling look *"
    color: {r: 0, g: 0, b: 0, a: 1}
    fontSize: 40
    autoSkipTime: 0
    skipState: 0
    OnStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1571391564}
          m_TargetAssemblyTypeName: Portrait, Assembly-CSharp
          m_MethodName: ShowPortrait
          m_Mode: 3
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 3
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    OnEnd:
      m_PersistentCalls:
        m_Calls: []
  - text: '* You want to prove yourself, you know this *'
    color: {r: 0, g: 0, b: 0, a: 1}
    fontSize: 40
